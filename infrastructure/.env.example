# Only needed for deploying the CDK stack from a local machine.
# In CI these are supplied by GitHub Actions secrets (see .github/workflows/cdk-deploy.yml).
# Copy to .env and fill in real values. Never commit the filled-in file.

# AWS account and region to deploy into
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=eu-north-1

# LangSmith tracing (smith.langchain.com)
LANGCHAIN_API_KEY=

# LlamaCloud document parsing (cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=

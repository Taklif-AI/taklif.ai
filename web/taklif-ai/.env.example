# Copy to .env.local and fill in real values. Never commit the filled-in file.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Used to sign the short-lived tokens embedded in result page URLs
JWT_SECRET=

# --- Google OAuth (console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- DynamoDB: next-auth table ---
AUTH_DYNAMODB_REGION=eu-north-1
AUTH_DYNAMODB_ID=
AUTH_DYNAMODB_SECRET=

# --- DynamoDB: assignments table ---
ASSIGNMENT_DYNAMODB_REGION=eu-north-1
ASSIGNMENT_DYNAMODB_ID=
ASSIGNMENT_DYNAMODB_SECRET=

# --- S3: user profile images ---
S3_REGION=eu-north-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM orchestration API (API Gateway) ---
# Both values come from the CDK stack outputs: OrchestrationApiEndpoint and
# OrchestrationApiKeyId. Resolve the key value with:
#   aws apigateway get-api-key --api-key <OrchestrationApiKeyId> --include-value
LLM_API_ENDPOINT=
LLM_API_KEY=

# --- Transactional email (resend.com) ---
RESEND_API_KEY=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
